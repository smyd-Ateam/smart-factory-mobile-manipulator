<?xml version="1.0"?>
<!-- block: YOLO class id 0 (Gazebo label 1). 원점 = 바닥 중심, 단위 m -->
<sdf version="1.8">
  <model name="block">
    <link name="link">
      <inertial>
        <pose>0 0 0.02 0 0 0</pose>
        <mass>0.03</mass>
        <inertia><ixx>5.5625e-06</ixx><ixy>0</ixy><ixz>0</ixz><iyy>5.5625e-06</iyy><iyz>0</iyz><izz>3.125e-06</izz></inertia>
      </inertial>
      <collision name="collision"><pose>0 0 0.02 0 0 0</pose><geometry><box><size>0.025 0.025 0.04</size></box></geometry></collision>
      <visual name="visual">
        <pose>0 0 0.02 0 0 0</pose><geometry><box><size>0.025 0.025 0.04</size></box></geometry>
        <material>
          <ambient>0.15 0.35 0.75 1</ambient>
          <diffuse>0.15 0.35 0.75 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
    </link>
    <!-- boundingbox camera가 이 번호로 박스를 만든다 (0은 배경이라 1부터 사용) -->
    <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label">
      <label>1</label>
    </plugin>
  </model>
</sdf>
