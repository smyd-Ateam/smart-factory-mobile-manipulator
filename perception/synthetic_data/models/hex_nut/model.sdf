<?xml version="1.0"?>
<!-- hex_nut: YOLO class id 2 (Gazebo label 3). 원점 = 바닥 중심, 단위 m -->
<sdf version="1.8">
  <model name="hex_nut">
    <link name="link">
      <inertial>
        <pose>0 0 0.0075 0 0 0</pose>
        <mass>0.02</mass>
        <inertia><ixx>1.875e-06</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.875e-06</iyy><iyz>0</iyz><izz>3e-06</izz></inertia>
      </inertial>
      <collision name="collision"><pose>0 0 0.0075 0 0 0</pose><geometry><cylinder><radius>0.0165</radius><length>0.015</length></cylinder></geometry></collision>
      <visual name="visual">
        <geometry><mesh><uri>model://hex_nut/meshes/hex_nut.stl</uri></mesh></geometry>
        <material>
          <ambient>0.38 0.39 0.43 1</ambient>
          <diffuse>0.38 0.39 0.43 1</diffuse>
          <specular>0.7 0.7 0.7 1</specular>
        </material>
      </visual>
    </link>
    <!-- boundingbox camera가 이 번호로 박스를 만든다 (0은 배경이라 1부터 사용) -->
    <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label">
      <label>3</label>
    </plugin>
  </model>
</sdf>
