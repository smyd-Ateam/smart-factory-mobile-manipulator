<?xml version="1.0"?>
<!--
  YOLO 합성 데이터 수집용 월드 (Gazebo Fortress, ogre2, 화면 없이 -s로 실행)
  - 부품 4종 x 2개, 라벨 없는 방해물 2개는 (50, 50) 근처에 대기하다가
    collect_data.py가 매 장면마다 카메라 앞으로 옮긴다.
  - camera_rig도 collect_data.py가 매번 위치와 각도를 바꾼다.
-->
<sdf version="1.8">
  <world name="collect">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <!-- boundingbox 카메라는 ogre2 전용 -->
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <ambient>0.6 0.6 0.55 1</ambient>
            <diffuse>0.6 0.6 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 카메라 리그: 중력 없음, 충돌 없음 → set_pose로 옮긴 자리에 그대로 떠 있음 -->
    <model name="camera_rig">
      <pose>-0.6 0 0.30 0 0.39 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <inertial>
          <mass>0.1</mass>
          <inertia><ixx>1e-4</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-4</iyy><iyz>0</iyz><izz>1e-4</izz></inertia>
        </inertial>
        <sensor name="bbox_camera" type="boundingbox_camera">
          <topic>boxes</topic>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <camera>
            <box_type>2d</box_type>
            <horizontal_fov>1.0472</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
            </image>
            <clip>
              <near>0.05</near>
              <far>10</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- 부품 4종 x 2개 (대기 위치) -->
    <include>
      <uri>model://block</uri>
      <name>block_0</name>
      <pose>50 50 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://block</uri>
      <name>block_1</name>
      <pose>51 50 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://pin</uri>
      <name>pin_0</name>
      <pose>52 50 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://pin</uri>
      <name>pin_1</name>
      <pose>53 50 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://hex_nut</uri>
      <name>hex_nut_0</name>
      <pose>54 50 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://hex_nut</uri>
      <name>hex_nut_1</name>
      <pose>55 50 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://bolt</uri>
      <name>bolt_0</name>
      <pose>56 50 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://bolt</uri>
      <name>bolt_1</name>
      <pose>57 50 0 0 0 0</pose>
    </include>

    <!-- 라벨 없는 방해물: 부품이 아닌 물체를 부품으로 착각하지 않게 하는 용도 -->
    <model name="distractor_0">
      <pose>60 50 0.016 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.02</mass><inertia><ixx>2e-6</ixx><ixy>0</ixy><ixz>0</ixz><iyy>2e-6</iyy><iyz>0</iyz><izz>2e-6</izz></inertia></inertial>
        <collision name="collision"><geometry><sphere><radius>0.015</radius></sphere></geometry></collision>
        <visual name="visual">
          <geometry><sphere><radius>0.015</radius></sphere></geometry>
          <material><ambient>0.9 0.45 0.1 1</ambient><diffuse>0.9 0.45 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="distractor_1">
      <pose>61 50 0.003 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.02</mass><inertia><ixx>3e-6</ixx><ixy>0</ixy><ixz>0</ixz><iyy>4e-6</iyy><iyz>0</iyz><izz>7e-6</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.05 0.04 0.005</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.04 0.005</size></box></geometry>
          <material><ambient>0.2 0.25 0.2 1</ambient><diffuse>0.2 0.25 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 바닥 매트 5종: 매 장면 하나를 카메라 앞에 깔아 바닥 색을 바꾼다 -->
    <model name="mat_0">  <!-- 밝은 콘크리트 -->
      <pose>70 70 0.001 0 0 0</pose>
      <link name="link">
        <inertial><mass>5</mass><inertia><ixx>6.7</ixx><ixy>0</ixy><ixz>0</ixz><iyy>6.7</iyy><iyz>0</iyz><izz>13.3</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>4 4 0.002</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>4 4 0.002</size></box></geometry>
          <material><ambient>0.78 0.78 0.76 1</ambient><diffuse>0.78 0.78 0.76 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="mat_1">  <!-- 어두운 회색 -->
      <pose>75 70 0.001 0 0 0</pose>
      <link name="link">
        <inertial><mass>5</mass><inertia><ixx>6.7</ixx><ixy>0</ixy><ixz>0</ixz><iyy>6.7</iyy><iyz>0</iyz><izz>13.3</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>4 4 0.002</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>4 4 0.002</size></box></geometry>
          <material><ambient>0.28 0.28 0.30 1</ambient><diffuse>0.28 0.28 0.30 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="mat_2">  <!-- 초록 에폭시 -->
      <pose>80 70 0.001 0 0 0</pose>
      <link name="link">
        <inertial><mass>5</mass><inertia><ixx>6.7</ixx><ixy>0</ixy><ixz>0</ixz><iyy>6.7</iyy><iyz>0</iyz><izz>13.3</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>4 4 0.002</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>4 4 0.002</size></box></geometry>
          <material><ambient>0.33 0.50 0.40 1</ambient><diffuse>0.33 0.50 0.40 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="mat_3">  <!-- 청회색 -->
      <pose>85 70 0.001 0 0 0</pose>
      <link name="link">
        <inertial><mass>5</mass><inertia><ixx>6.7</ixx><ixy>0</ixy><ixz>0</ixz><iyy>6.7</iyy><iyz>0</iyz><izz>13.3</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>4 4 0.002</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>4 4 0.002</size></box></geometry>
          <material><ambient>0.40 0.46 0.58 1</ambient><diffuse>0.40 0.46 0.58 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="mat_4">  <!-- 베이지 -->
      <pose>90 70 0.001 0 0 0</pose>
      <link name="link">
        <inertial><mass>5</mass><inertia><ixx>6.7</ixx><ixy>0</ixy><ixz>0</ixz><iyy>6.7</iyy><iyz>0</iyz><izz>13.3</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>4 4 0.002</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>4 4 0.002</size></box></geometry>
          <material><ambient>0.76 0.70 0.55 1</ambient><diffuse>0.76 0.70 0.55 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
